{
  "info": {
    "name": "TpFoyer API",
    "description": "Collection Postman pour tester tous les endpoints du projet TpFoyer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8089/TpFoyer"
    },
    {
      "key": "blocId",
      "value": "1"
    },
    {
      "key": "chambreId",
      "value": "1"
    },
    {
      "key": "etudiantId",
      "value": "1"
    },
    {
      "key": "foyerId",
      "value": "1"
    },
    {
      "key": "reservationId",
      "value": "RES-2026-001"
    },
    {
      "key": "nomBloc",
      "value": "Bloc A"
    },
    {
      "key": "minReservations",
      "value": "1"
    },
    {
      "key": "universiteId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Bloc",
      "item": [
        {
          "name": "Get All Blocs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bloc/retrieve-all-blocs"
          }
        },
        {
          "name": "Get Bloc By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bloc/retrieve-bloc/{{blocId}}"
          }
        },
        {
          "name": "Add Bloc",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomBloc\": \"Bloc A\",\n  \"capaciteBloc\": 120\n}"
            },
            "url": "{{baseUrl}}/bloc/add-bloc"
          }
        },
        {
          "name": "Modify Bloc",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idBloc\": {{blocId}},\n  \"nomBloc\": \"Bloc A Modifie\",\n  \"capaciteBloc\": 150\n}"
            },
            "url": "{{baseUrl}}/bloc/modify-bloc"
          }
        },
        {
          "name": "Remove Bloc",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/bloc/remove-bloc/{{blocId}}"
          }
        },
        {
          "name": "Get Blocs Sans Foyer",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bloc/retrieve-blocs-sans-foyer"
          }
        },
        {
          "name": "Get Blocs Capacite > 30",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bloc/retrieve-blocs-by-capacite-superieure/30"
          }
        },
        {
          "name": "Get Blocs Nom Commence Par A",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bloc/retrieve-blocs-by-nom-prefix/A"
          }
        },
        {
          "name": "Get Blocs Nom A Et Capacite > 30",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bloc/retrieve-blocs-by-nom-prefix-and-capacite-superieure/A/30"
          }
        }
      ]
    },
    {
      "name": "Chambre",
      "item": [
        {
          "name": "Get All Chambres",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/chambre/retrieve-all-chambres"
          }
        },
        {
          "name": "Get Chambre By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/chambre/retrieve-chambre/{{chambreId}}"
          }
        },
        {
          "name": "Add Chambre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroChambre\": 101,\n  \"typeC\": \"DOUBLE\",\n  \"bloc\": {\n    \"idBloc\": {{blocId}}\n  }\n}"
            },
            "url": "{{baseUrl}}/chambre/add-chambre"
          }
        },
        {
          "name": "Modify Chambre",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idChambre\": {{chambreId}},\n  \"numeroChambre\": 102,\n  \"typeC\": \"TRIPLE\",\n  \"bloc\": {\n    \"idBloc\": {{blocId}}\n  }\n}"
            },
            "url": "{{baseUrl}}/chambre/modify-chambre"
          }
        },
        {
          "name": "Remove Chambre",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/chambre/remove-chambre/{{chambreId}}"
          }
        },
        {
          "name": "Add Chambre Et Reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroChambre\": 201,\n  \"typeC\": \"SIMPLE\",\n  \"reservation\": [\n    {\n      \"idReservation\": \"{{reservationId}}\",\n      \"anneeUniversitaire\": \"2026-09-01T00:00:00.000+00:00\",\n      \"estvalide\": true\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/chambre/ajouter-chambre-et-reservation"
          }
        },
        {
          "name": "Affecter Reservation A Chambre",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/chambre/affecter-reservation-chambre/{{reservationId}}/{{chambreId}}"
          }
        },
        {
          "name": "Get Chambres By Type DOUBLE",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/chambre/retrieve-chambres-by-type/DOUBLE"
          }
        },
        {
          "name": "Get Chambre By Numero",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/chambre/retrieve-chambre-by-numero/101"
          }
        }
      ]
    },
