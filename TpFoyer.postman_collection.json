        },
        {
          "name": "JPQL MEMBER OF - Reservations By Etudiant",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reservation/jpql/member-of/etudiant/{{etudiantId}}"
          }
        },
        {
          "name": "JPQL Double JOIN - Reservations By Bloc",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reservation/jpql/double-join/bloc/{{nomBloc}}"
          }
        },
        {
          "name": "JPQL GROUP BY - Count Reservations By Chambre",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reservation/jpql/group-by/chambres?minReservations={{minReservations}}"
          }
        }
