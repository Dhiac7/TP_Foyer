              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idReservation\": \"{{reservationId}}\",\n  \"anneeUniversitaire\": \"2026-09-01T00:00:00.000+00:00\",\n  \"estvalide\": true\n}"
            },
            "url": "{{baseUrl}}/reservation/add-reservation"
