              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomFoyer\": \"Foyer Sud\",\n  \"capaciteFoyer\": 300,\n  \"blocs\": [\n    {\n      \"nomBloc\": \"Bloc B\",\n      \"capaciteBloc\": 100\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/foyer/ajouter-foyer-et-bloc"
