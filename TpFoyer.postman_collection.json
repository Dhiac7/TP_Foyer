        {
          "name": "Desaffecter Bloc Du Foyer",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/foyer/desaffecter-bloc-foyer/{{blocId}}"
          }
        }
      ]
    },
    {
